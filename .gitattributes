# Set the default behavior, in case people don't have core.autocrlf set.
* eol=crlf

# Denote all files that are truly binary and should not be modified.
*.snk binary
*.exe binary

*.dll binary
*.png binary
*.jpg binary
*.gif binary
*.bmp binary
*.zip binary
*.ico binary
*.dll binary

# some non-binary files should be marked as binary because they deliberately have mixed line endings.
example_ini.ini binary


